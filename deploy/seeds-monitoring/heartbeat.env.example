# Install on seed1 as /etc/vtorrent/heartbeat.env, mode 0600, owner root.
# The UUID is a credential; never commit the real file.

# Success URL from the dead-man service. Example for healthchecks.io:
#   https://hc-ping.com/00000000-0000-0000-0000-000000000000
DEADMAN_PING_URL=REPLACE_WITH_PING_URL

# Optional: hit once when local readiness fails so the alert carries a reason.
# Example: https://hc-ping.com/00000000-0000-0000-0000-000000000000/fail
# DEADMAN_FAIL_URL=
