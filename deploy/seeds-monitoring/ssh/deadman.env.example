# Install on the host that runs the timer (seed2 or seed3) as
# /etc/vtorrent/deadman.env with mode 0600 and owner root. Never commit the real
# file: this topic name is the credential.
#
# The private key and pinned known-hosts file live beside it, also 0600.

# ntfy topic that receives the failure and recovery notifications.
NTFY_TOPIC=REPLACE_WITH_TOPIC

# Dedicated, restricted identity on seed1. deadman.sh connects with
# StrictHostKeyChecking=yes and this exact name, so the pinned known-hosts file
# must contain an entry for this same name (for example a `seed1` line).
SEED1_SSH_TARGET=deadman@seed1

SEED1_SSH_KEY=/etc/vtorrent/deadman-key
SEED1_KNOWN_HOSTS=/etc/vtorrent/deadman-known-hosts
